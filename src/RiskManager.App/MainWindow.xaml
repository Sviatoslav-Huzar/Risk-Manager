<Window x:Class="RiskManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RiskManager.App.ViewModels"
        xmlns:views="clr-namespace:RiskManager.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- InputGestureText only shows the shortcut; it works because of the
             KeyBinding above. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Новий" InputGestureText="Ctrl+N" Command="{Binding NewCommand}" />
                <MenuItem Header="_Відкрити…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <Separator />
                <MenuItem Header="_Зберегти" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Зберегти _як…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="Ви_хід" InputGestureText="Alt+F4" Click="OnExitClick" />
            </MenuItem>
        </Menu>

        <!-- The window's DataContext is MainViewModel (set in App.OnStartup). Here
             it changes to the open project, and every tab picks its own part of it.
             New and Open replace Project, and all tabs follow. -->
        <TabControl Margin="8" DataContext="{Binding Project}">
            <TabItem Header="Джерела ризиків">
                <!-- Sources is a property of ProjectViewModel: from here on down
                     the DataContext is ChecklistViewModel. -->
                <views:ChecklistView DataContext="{Binding Sources}"
                                     Instruction="Етап 1.1. Позначте джерела ризиків, які наявні у вашому програмному проєкті." />
            </TabItem>

            <!-- The same control, another part of the project and another text. -->
            <TabItem Header="Ризикові події">
                <views:ChecklistView DataContext="{Binding Events}"
                                     Instruction="Етап 1.2. Позначте ризикові події, які можуть настати у вашому програмному проєкті." />
            </TabItem>

            <TabItem Header="Експертні оцінки">
                <views:EstimatesView DataContext="{Binding Estimates}" />
            </TabItem>

            <TabItem Header="Аналіз">
                <views:AnalysisView DataContext="{Binding Analysis}" />
            </TabItem>

            <TabItem Header="Заходи">
                <views:MeasuresView DataContext="{Binding Measures}" />
            </TabItem>

            <TabItem Header="Моніторинг">
                <views:MonitoringView DataContext="{Binding Monitoring}" />
            </TabItem>

            <TabItem Header="Графіки">
                <views:ChartsView DataContext="{Binding Charts}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window x:Class="RiskManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RiskManager.App.ViewModels"
        xmlns:views="clr-namespace:RiskManager.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="Управління ризиками розроблення ПЗ" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- One style for all tabs that are not implemented yet. -->
        <Style x:Key="PlaceholderText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Text" Value="Буде реалізовано в наступних ітераціях" />
        </Style>
    </Window.Resources>

    <!-- The window's DataContext is MainViewModel (set in App.OnStartup);
         every tab picks its own part of it. -->
    <TabControl Margin="8">
        <TabItem Header="Джерела ризиків">
            <!-- Sources is a property of MainViewModel: from here on down
                 the DataContext is ChecklistViewModel. -->
            <views:ChecklistView DataContext="{Binding Sources}"
                                 Instruction="Етап 1.1. Позначте джерела ризиків, які наявні у вашому програмному проєкті." />
        </TabItem>

        <!-- The same control, another part of MainViewModel and another text. -->
        <TabItem Header="Ризикові події">
            <views:ChecklistView DataContext="{Binding Events}"
                                 Instruction="Етап 1.2. Позначте ризикові події, які можуть настати у вашому програмному проєкті." />
        </TabItem>

        <TabItem Header="Експертні оцінки">
            <views:EstimatesView DataContext="{Binding Estimates}" />
        </TabItem>

        <TabItem Header="Аналіз">
            <views:AnalysisView DataContext="{Binding Analysis}" />
        </TabItem>

        <TabItem Header="Заходи">
            <views:MeasuresView DataContext="{Binding Measures}" />
        </TabItem>

        <TabItem Header="Моніторинг">
            <TextBlock Style="{StaticResource PlaceholderText}" />
        </TabItem>
    </TabControl>
</Window>

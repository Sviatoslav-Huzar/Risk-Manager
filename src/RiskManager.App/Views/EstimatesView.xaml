<UserControl x:Class="RiskManager.App.Views.EstimatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RiskManager.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EstimatesViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1050" d:DesignHeight="600">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Padding="12,4"
                    Content="Заповнити випадково"
                    ToolTip="Заповнює лише порожні клітинки змодельованими значеннями"
                    Command="{Binding FillRandomCommand}" />

            <TextBlock DockPanel.Dock="Right" Margin="16,0" VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Заповнено {0} з {1}">
                        <Binding Path="CompleteCount" />
                        <Binding Path="Rows.Count" Mode="OneWay" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Етап 2. Введіть ймовірності від 10 експертів (Е1–Е10) і можливі збитки lr у межах від 0 до 1." />
        </DockPanel>

        <!-- The expert columns are added before LossColumn in EstimatesView.xaml.cs. -->
        <DataGrid x:Name="Table" Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  FrozenColumnCount="2"
                  HeadersVisibility="Column"
                  SelectionUnit="Cell">
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Width="45" IsReadOnly="True"
                                    Binding="{Binding Code, Mode=OneWay}" />
                <DataGridTextColumn Header="Ризикова подія" Width="230" IsReadOnly="True"
                                    ElementStyle="{StaticResource DescriptionCell}"
                                    Binding="{Binding Description, Mode=OneWay}" />

                <DataGridTextColumn x:Name="LossColumn" Header="lr" Width="50"
                                    ElementStyle="{StaticResource NumberCell}"
                                    EditingElementStyle="{StaticResource NumberEditor}"
                                    Binding="{Binding Loss, Converter={StaticResource NullableNumberConverter}, UpdateSourceTrigger=LostFocus}" />

                <DataGridTextColumn Header="er" Width="55" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"
                                    Binding="{Binding Probability, Mode=OneWay, StringFormat=N3}" />
                <DataGridTextColumn Header="vr" Width="55" IsReadOnly="True"
                                    ElementStyle="{StaticResource NumberCell}"
                                    Binding="{Binding Value, Mode=OneWay, StringFormat=N3}" />
                <DataGridTextColumn Header="Ймовірність" Width="95" IsReadOnly="True"
                                    Binding="{Binding ProbabilityLevel, Mode=OneWay, Converter={StaticResource ProbabilityLevelConverter}}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1"
                   Text="Спочатку позначте події на вкладці «Ризикові події»">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>

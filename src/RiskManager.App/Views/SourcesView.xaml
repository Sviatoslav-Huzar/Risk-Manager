<UserControl x:Class="RiskManager.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RiskManager.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SourcesViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1000" d:DesignHeight="600">

    <!-- The DataContext (SourcesViewModel) is NOT set here: the parent passes
         it in, see MainWindow.xaml. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="Етап 1.1. Позначте джерела ризиків, які наявні у вашому програмному проєкті." />

        <!-- Left: check boxes grouped by category.
             HorizontalScrollBarVisibility="Disabled" limits the content width
             to the visible area, otherwise long descriptions would not wrap. -->
        <ScrollViewer Grid.Row="1" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- Each item of Groups becomes the DataContext of one GroupBox. -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <!-- DataType does not change behaviour here; it tells the
                         designer the type, so IntelliSense checks the bindings. -->
                    <DataTemplate DataType="{x:Type vm:SourceGroupViewModel}">
                        <GroupBox Margin="0,0,8,12" Padding="8,4"
                                  Header="{Binding Category, Converter={StaticResource CategoryNameConverter}}">

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SourceItemViewModel}">
                                        <!-- IsChecked is TwoWay by default: a click writes IsPresent. -->
                                        <CheckBox Margin="0,3" IsChecked="{Binding IsPresent}">
                                            <TextBlock TextWrapping="Wrap">
                                                <!-- Run.Text is TwoWay by default, and Code/Description
                                                     are read-only, so OneWay is required here. -->
                                                <Run FontWeight="SemiBold" Text="{Binding Code, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding Description, Mode=OneWay}" />
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Right: the live result of formulas (5.2)-(5.3). -->
        <Border Grid.Row="1" Grid.Column="1"
                Margin="12,0,0,0" Padding="12"
                MinWidth="320"
                VerticalAlignment="Top"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">

            <!-- Every row below is a separate Grid. IsSharedSizeScope together
                 with SharedSizeGroup makes the columns of all rows equally
                 wide, so the numbers line up. -->
            <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold"
                           Text="Підсумок ідентифікації" />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SourceGroupViewModel}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="Name" />
                                    <ColumnDefinition SharedSizeGroup="Symbol" />
                                    <ColumnDefinition SharedSizeGroup="Count" />
                                    <ColumnDefinition SharedSizeGroup="Share" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Category, Converter={StaticResource CategoryNameConverter}}" />

                                <!-- The converter runs first, then StringFormat: "(tc)". -->
                                <TextBlock Grid.Column="1" Margin="6,0,0,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding Category, Converter={StaticResource CategorySymbolConverter}, StringFormat='({0})'}" />

                                <!-- MultiBinding combines several values into one string. -->
                                <TextBlock Grid.Column="2" Margin="16,0,0,0" TextAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} з {1}">
                                            <Binding Path="PresentCount" />
                                            <Binding Path="CategoryCount" Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Column="3" Margin="16,0,0,0" TextAlignment="Right"
                                           Text="{Binding Share, StringFormat={}{0:P2}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,8" />

                <!-- Same SharedSizeGroup names: the total lines up with the shares. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Name" />
                        <ColumnDefinition SharedSizeGroup="Symbol" />
                        <ColumnDefinition SharedSizeGroup="Count" />
                        <ColumnDefinition SharedSizeGroup="Share" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Разом" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="(R)" />
                    <TextBlock Grid.Column="3" Margin="16,0,0,0" TextAlignment="Right" FontWeight="SemiBold"
                               Text="{Binding Total, StringFormat={}{0:P2}}" />
                </Grid>

                <!-- A button enables/disables itself from the command's CanExecute. -->
                <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" Padding="12,4"
                            Content="Позначити все"
                            Command="{Binding SelectAllCommand}" />
                    <Button Padding="12,4"
                            Content="Скинути"
                            Command="{Binding ClearAllCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

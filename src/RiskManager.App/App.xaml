<Application x:Class="RiskManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RiskManager.App"
             xmlns:conv="clr-namespace:RiskManager.App.Converters"
             xmlns:domain="clr-namespace:RiskManager.Core.Domain;assembly=RiskManager.Core">
    <Application.Resources>
        <!-- Application-wide resources: available to every window and view
             through {StaticResource Key}. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/TableStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:CategoryNameConverter x:Key="CategoryNameConverter" />
            <conv:CategorySymbolConverter x:Key="CategorySymbolConverter" />
            <conv:NullableNumberConverter x:Key="NullableNumberConverter" />
            <conv:ProbabilityLevelConverter x:Key="ProbabilityLevelConverter" />
            <conv:PriorityLevelConverter x:Key="PriorityLevelConverter" />

            <!-- Has no key: it is applied to every PriorityLevel that is shown
                 as the content of an element. The text color is fixed because
                 the background is, even in a selected row. -->
            <DataTemplate DataType="{x:Type domain:PriorityLevel}">
                <Border x:Name="Badge" Margin="2,1" Padding="6,1" CornerRadius="3"
                        VerticalAlignment="Center" Background="#D7F0DD">
                    <TextBlock TextAlignment="Center" Foreground="#1F2937"
                               Text="{Binding Converter={StaticResource PriorityLevelConverter}}" />
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Static domain:PriorityLevel.Medium}">
                        <Setter TargetName="Badge" Property="Background" Value="#FDECB8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="{x:Static domain:PriorityLevel.High}">
                        <Setter TargetName="Badge" Property="Background" Value="#F9CFCF" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
